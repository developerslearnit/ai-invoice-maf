@model DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
    ViewData["Breadcrumb"] = "Overview";
}

<div class="space-y-8">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 flex items-start justify-between gap-4 shadow-sm">
            <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div>
                    <h4 class="text-sm font-semibold">Backend Connection Warning</h4>
                    <p class="text-xs text-amber-700 mt-0.5">@Model.ErrorMessage Check that the Invoice API is active at <code class="font-mono bg-amber-100/60 px-1 py-0.5 rounded">http://localhost:5231</code>.</p>
                </div>
            </div>
            <a href="/" class="px-3 py-1.5 text-xs font-semibold bg-amber-600 hover:bg-amber-700 text-white rounded-xl shadow-sm transition-colors shrink-0">
                Retry
            </a>
        </div>
    }

    <!-- Metric Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
        <!-- Total Invoices -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Invoices</span>
                <span class="text-lg">📁</span>
            </div>
            <div class="text-2xl font-bold text-slate-900 tracking-tight">@Model.Summary.TotalInvoices</div>
            <div class="text-[11px] text-slate-500 mt-1">Across all accounts</div>
        </div>

        <!-- Paid Invoices -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Paid</span>
                <span class="text-lg">✅</span>
            </div>
            <div class="text-2xl font-bold text-emerald-600 tracking-tight">@Model.Summary.PaidInvoices</div>
            <div class="text-[11px] text-slate-500 mt-1">@Model.PaidPercentage% collection rate</div>
        </div>

        <!-- Outstanding -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Outstanding</span>
                <span class="text-lg">⏳</span>
            </div>
            <div class="text-2xl font-bold text-amber-600 tracking-tight">@CurrencyHelper.FormatCompact(Model.Summary.TotalOutstandingAmount)</div>
            <div class="text-[11px] text-slate-500 mt-1">Pending settlement</div>
        </div>

        <!-- Overdue Invoices -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Overdue</span>
                <span class="text-lg">🚨</span>
            </div>
            <div class="text-2xl font-bold text-rose-600 tracking-tight">@Model.Summary.OverdueInvoices</div>
            <div class="text-[11px] text-slate-500 mt-1">Requires follow-up</div>
        </div>

        <!-- Total Invoiced -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Invoiced</span>
                <span class="text-lg">💼</span>
            </div>
            <div class="text-2xl font-bold text-slate-900 tracking-tight">@CurrencyHelper.FormatCompact(Model.Summary.TotalInvoiceAmount)</div>
            <div class="text-[11px] text-slate-500 mt-1">Gross volume</div>
        </div>

        <!-- Total Paid -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-soft hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Paid</span>
                <span class="text-lg">💰</span>
            </div>
            <div class="text-2xl font-bold text-brand-600 tracking-tight">@CurrencyHelper.FormatCompact(Model.Summary.TotalPaidAmount)</div>
            <div class="text-[11px] text-slate-500 mt-1">Realized revenue</div>
        </div>
    </div>

    <!-- Visual Invoice Status Overview Bar -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-soft">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
                <h3 class="text-sm font-bold text-slate-900">Invoice Status Distribution</h3>
                <p class="text-xs text-slate-500">Live operational lifecycle breakdown</p>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-xs font-medium">
                <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Paid (@Model.PaidPercentage%)</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span> Sent (@Model.SentPercentage%)</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Overdue (@Model.OverduePercentage%)</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span> Draft (@Model.DraftPercentage%)</span>
            </div>
        </div>

        <!-- Progress Distribution Bar -->
        <div class="w-full h-3 rounded-full bg-slate-100 flex overflow-hidden">
            <div style="width: @(Model.PaidPercentage)%" class="bg-emerald-500 h-full transition-all duration-500" title="Paid: @Model.PaidPercentage%"></div>
            <div style="width: @(Model.SentPercentage)%" class="bg-sky-500 h-full transition-all duration-500" title="Sent: @Model.SentPercentage%"></div>
            <div style="width: @(Model.OverduePercentage)%" class="bg-rose-500 h-full transition-all duration-500" title="Overdue: @Model.OverduePercentage%"></div>
            <div style="width: @(Model.DraftPercentage)%" class="bg-slate-300 h-full transition-all duration-500" title="Draft: @Model.DraftPercentage%"></div>
        </div>
    </div>

    <!-- Two-Column Section: Recent Invoices & Overdue Invoices -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Recent Invoices (2 Cols) -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-soft overflow-hidden flex flex-col">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Recent Invoices</h3>
                    <p class="text-xs text-slate-500">Latest billing activity</p>
                </div>
                <a asp-controller="Invoices" asp-action="Index" class="text-xs font-semibold text-brand-600 hover:text-brand-700">
                    View All &rarr;
                </a>
            </div>

            <div class="flex-1 overflow-x-auto">
                @if (Model.RecentInvoices.Count == 0)
                {
                    <div class="p-8 text-center">
                        <div class="text-3xl mb-2">📄</div>
                        <h4 class="text-sm font-bold text-slate-900">No invoices found</h4>
                        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Create your first invoice to begin tracking billing activity across clients.</p>
                        <button type="button" onclick="InvoicesManager.openCreateModal()" class="mt-4 px-4 py-2 text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white rounded-xl shadow-sm transition-colors">
                            + New Invoice
                        </button>
                    </div>
                }
                else
                {
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 text-[11px] font-semibold text-slate-400 uppercase tracking-wider bg-slate-50/50">
                                <th class="py-3 px-5">Invoice #</th>
                                <th class="py-3 px-4">Customer</th>
                                <th class="py-3 px-4">Due Date</th>
                                <th class="py-3 px-4 text-right">Amount</th>
                                <th class="py-3 px-4 text-center">Status</th>
                                <th class="py-3 px-5 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-xs">
                            @foreach (var inv in Model.RecentInvoices)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-5 font-semibold text-brand-600">
                                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id" class="hover:underline">
                                            @inv.InvoiceNumber
                                        </a>
                                    </td>
                                    <td class="py-3.5 px-4 font-medium text-slate-800">@inv.CustomerName</td>
                                    <td class="py-3.5 px-4 text-slate-500">@DateHelper.Format(inv.DueDate)</td>
                                    <td class="py-3.5 px-4 text-right font-semibold text-slate-900">@CurrencyHelper.FormatNaira(inv.TotalAmount)</td>
                                    <td class="py-3.5 px-4 text-center">
                                        <partial name="_InvoiceStatusBadge" model="inv.Status" />
                                    </td>
                                    <td class="py-3.5 px-5 text-right">
                                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id"
                                           class="inline-flex items-center text-xs font-semibold text-slate-600 hover:text-brand-600 p-1">
                                            Details &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Overdue Invoices (1 Col) -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-soft overflow-hidden flex flex-col">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-rose-50/40">
                <div class="flex items-center gap-2">
                    <span class="text-rose-600">🚨</span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Overdue Alerts</h3>
                        <p class="text-xs text-rose-600 font-medium">Pending critical follow-up</p>
                    </div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-700">
                    @Model.OverdueInvoices.Count
                </span>
            </div>

            <div class="p-4 flex-1 overflow-y-auto max-h-[380px] space-y-3 custom-scrollbar">
                @if (Model.OverdueInvoices.Count == 0)
                {
                    <div class="p-6 text-center text-slate-400">
                        <div class="text-2xl mb-1">🎉</div>
                        <div class="text-xs font-semibold text-slate-700">No overdue invoices</div>
                        <div class="text-[11px] text-slate-400 mt-0.5">All customer balances are in good standing.</div>
                    </div>
                }
                else
                {
                    @foreach (var inv in Model.OverdueInvoices)
                    {
                        <div class="p-3.5 rounded-xl border border-rose-100 bg-rose-50/30 hover:bg-rose-50/60 transition-colors flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id" class="text-xs font-bold text-slate-900 hover:text-brand-600 truncate block">
                                    @inv.InvoiceNumber &bull; @inv.CustomerName
                                </a>
                                <div class="text-[11px] text-rose-600 font-medium mt-0.5">
                                    Due: @DateHelper.Format(inv.DueDate)
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <div class="text-xs font-bold text-rose-700">@CurrencyHelper.FormatNaira(inv.TotalAmount)</div>
                                <button type="button"
                                        onclick="InvoicesManager.promptStatusChange('@inv.Id', '@inv.InvoiceNumber', 'Overdue', 'Paid')"
                                        class="text-[10px] text-brand-600 hover:underline font-semibold mt-1">
                                    Mark Paid
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-slate-50 border-t border-slate-100 text-center">
                <button type="button" onclick="AiAssistant.open(); AiAssistant.sendMessage('Which invoices are overdue?')"
                        class="text-xs font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1.5">
                    <span>✨ Ask AI to summarize overdue accounts</span>
                </button>
            </div>
        </div>
    </div>
</div>
