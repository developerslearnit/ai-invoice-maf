@model InvoiceDetailsViewModel
@{
    ViewData["Title"] = Model.Invoice?.InvoiceNumber ?? "Invoice Details";
    ViewData["Breadcrumb"] = Model.Invoice?.InvoiceNumber ?? "Details";
}

<div class="space-y-6">
    <!-- Back Navigation & Lifecycle Actions Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            <span>Back to Invoices</span>
        </a>

        @if (Model.Invoice is not null)
        {
            <!-- Contextual Status Transition Buttons -->
            <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        onclick="AiAssistant.open(); AiAssistant.sendMessage('Summarize this invoice and check customer status')"
                        class="px-3.5 py-2 text-xs font-semibold bg-indigo-50 hover:bg-indigo-100 text-brand-700 border border-brand-200 rounded-xl transition-colors inline-flex items-center gap-1.5">
                    <span>✨ Ask AI About Invoice</span>
                </button>

                @if (Model.CanMarkSent)
                {
                    <button type="button"
                            onclick="InvoicesManager.promptStatusChange('@Model.Invoice.Id', '@Model.Invoice.InvoiceNumber', 'Draft', 'Sent')"
                            class="px-3.5 py-2 text-xs font-semibold text-white bg-sky-600 hover:bg-sky-700 rounded-xl shadow-sm transition-colors">
                        Mark as Sent
                    </button>
                }

                @if (Model.CanMarkPaid)
                {
                    <button type="button"
                            onclick="InvoicesManager.promptStatusChange('@Model.Invoice.Id', '@Model.Invoice.InvoiceNumber', '@Model.Invoice.Status', 'Paid')"
                            class="px-3.5 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-colors">
                        Mark as Paid
                    </button>
                }

                @if (Model.CanMarkOverdue)
                {
                    <button type="button"
                            onclick="InvoicesManager.promptStatusChange('@Model.Invoice.Id', '@Model.Invoice.InvoiceNumber', 'Sent', 'Overdue')"
                            class="px-3.5 py-2 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 hover:bg-amber-100 rounded-xl transition-colors">
                        Mark as Overdue
                    </button>
                }

                @if (Model.CanCancel)
                {
                    <button type="button"
                            onclick="InvoicesManager.promptStatusChange('@Model.Invoice.Id', '@Model.Invoice.InvoiceNumber', '@Model.Invoice.Status', 'Cancelled')"
                            class="px-3.5 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                        Cancel Invoice
                    </button>
                }

                @if (Model.CanDelete)
                {
                    <button type="button"
                            onclick="InvoicesManager.promptDeleteDraft('@Model.Invoice.Id', '@Model.Invoice.InvoiceNumber')"
                            class="px-3.5 py-2 text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 hover:bg-rose-100 rounded-xl transition-colors">
                        Delete Draft
                    </button>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 flex items-center justify-between">
            <div class="text-xs">@Model.ErrorMessage</div>
            <a asp-action="Index" class="text-xs font-semibold underline">Return to Invoices</a>
        </div>
    }

    @if (Model.Invoice is not null)
    {
        <!-- Invoice Header Document Card -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-soft">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-slate-100">
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">@Model.Invoice.InvoiceNumber</h2>
                        <partial name="_InvoiceStatusBadge" model="Model.Invoice.Status" />
                    </div>
                    <div class="mt-2 text-xs text-slate-500">
                        Billed to:
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Invoice.Customer.Id"
                           class="font-semibold text-brand-600 hover:underline">
                            @Model.Invoice.Customer.Name
                        </a>
                        (@Model.Invoice.Customer.Email)
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-6 text-xs">
                    <div>
                        <div class="font-semibold text-slate-400 uppercase tracking-wider text-[11px]">Issue Date</div>
                        <div class="font-bold text-slate-800 text-sm mt-0.5">@DateHelper.Format(Model.Invoice.IssueDate)</div>
                    </div>
                    <div>
                        <div class="font-semibold text-slate-400 uppercase tracking-wider text-[11px]">Due Date</div>
                        <div class="font-bold text-slate-800 text-sm mt-0.5">@DateHelper.Format(Model.Invoice.DueDate)</div>
                    </div>
                    <div class="text-right">
                        <div class="font-semibold text-slate-400 uppercase tracking-wider text-[11px]">Total Balance</div>
                        <div class="font-extrabold text-brand-600 text-xl sm:text-2xl mt-0.5">@CurrencyHelper.FormatNaira(Model.Invoice.TotalAmount)</div>
                    </div>
                </div>
            </div>

            <!-- AI Query Banner -->
            <div class="mt-4 p-3 bg-brand-50/70 border border-brand-100 rounded-xl flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-brand-800">
                    <span>✨</span>
                    <span>Ask Invoice AI about <strong>@Model.Invoice.InvoiceNumber</strong></span>
                </div>
                <button type="button"
                        onclick="AiAssistant.open(); AiAssistant.sendMessage('Summarize this invoice');"
                        class="px-3 py-1 text-xs font-bold text-brand-700 bg-white hover:bg-brand-100 border border-brand-200 rounded-lg shadow-2xs transition-colors">
                    Summarize with AI &rarr;
                </button>
            </div>

            <!-- Items Table -->
            <div class="mt-8">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Itemized Billing</h3>
                <div class="overflow-x-auto border border-slate-100 rounded-xl">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 text-[11px] font-semibold text-slate-400 uppercase tracking-wider bg-slate-50/60">
                                <th class="py-3 px-4">#</th>
                                <th class="py-3 px-4">Description</th>
                                <th class="py-3 px-4 text-right">Quantity</th>
                                <th class="py-3 px-4 text-right">Unit Price</th>
                                <th class="py-3 px-4 text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-xs">
                            @{ int index = 1; }
                            @foreach (var item in Model.Invoice.Items)
                            {
                                <tr class="hover:bg-slate-50/40">
                                    <td class="py-3.5 px-4 text-slate-400">@index</td>
                                    <td class="py-3.5 px-4 font-semibold text-slate-800">@item.Description</td>
                                    <td class="py-3.5 px-4 text-right text-slate-600 font-mono">@item.Quantity.ToString("0.####")</td>
                                    <td class="py-3.5 px-4 text-right text-slate-600 font-mono">@CurrencyHelper.FormatNaira(item.UnitPrice)</td>
                                    <td class="py-3.5 px-4 text-right font-bold text-slate-900 font-mono">@CurrencyHelper.FormatNaira(item.LineTotal)</td>
                                </tr>
                                index++;
                            }
                        </tbody>
                        <tfoot>
                            <tr class="bg-slate-50/80 border-t border-slate-200 text-xs">
                                <td colspan="4" class="py-3.5 px-4 text-right font-bold text-slate-700">Grand Total</td>
                                <td class="py-3.5 px-4 text-right font-extrabold text-brand-700 text-sm font-mono">@CurrencyHelper.FormatNaira(Model.Invoice.TotalAmount)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Notes / Terms -->
            @if (!string.IsNullOrWhiteSpace(Model.Invoice.Notes))
            {
                <div class="mt-8 pt-6 border-t border-slate-100">
                    <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Terms & Notes</h4>
                    <div class="text-xs text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-200/60 leading-relaxed">
                        @Model.Invoice.Notes
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    @if (Model.Invoice is not null)
    {
        <script>
            // Set contextual page state for AI Assistant
            window.__AI_CONTEXT__ = {
                page: "InvoiceDetails",
                invoiceId: "@Model.Invoice.Id",
                invoiceNumber: "@Model.Invoice.InvoiceNumber",
                customerId: "@Model.Invoice.Customer.Id",
                customerName: "@Model.Invoice.Customer.Name"
            };
        </script>
    }
}
