@model CustomerDetailsViewModel
@{
    ViewData["Title"] = Model.Customer?.Name ?? "Customer Details";
    ViewData["Breadcrumb"] = Model.Customer?.Name ?? "Details";
}

<div class="space-y-6">
    <!-- Back Link & Action Bar -->
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            <span>Back to Customers</span>
        </a>
        @if (Model.Customer is not null)
        {
            <div class="flex items-center gap-2">
                <button type="button"
                        onclick="AiAssistant.open(); AiAssistant.sendMessage('What is @Model.Customer.Name\'s payment track record and outstanding balance?')"
                        class="px-3.5 py-2 text-xs font-semibold bg-indigo-50 hover:bg-indigo-100 text-brand-700 border border-brand-200 rounded-xl transition-colors inline-flex items-center gap-1.5">
                    <span>✨ AI Customer Profile</span>
                </button>
                <button type="button" onclick="CustomersManager.openEditModal('@Model.Customer.Id')"
                        class="px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl shadow-sm transition-colors">
                    Edit Profile
                </button>
                <button type="button" onclick="InvoicesManager.openCreateModal()"
                        class="px-3.5 py-2 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl shadow-sm transition-colors">
                    + New Invoice for Customer
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 flex items-center justify-between">
            <div class="text-xs">@Model.ErrorMessage</div>
            <a asp-action="Index" class="text-xs font-semibold underline">Return to Customers</a>
        </div>
    }

    @if (Model.Customer is not null)
    {
        <!-- Customer Overview Card -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-soft flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 text-white font-bold text-2xl flex items-center justify-center shadow-md">
                    @Model.Customer.Name.Substring(0, Math.Min(2, Model.Customer.Name.Length)).ToUpperInvariant()
                </div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-slate-900">@Model.Customer.Name</h2>
                    <div class="flex flex-wrap items-center gap-y-1 gap-x-4 text-xs text-slate-500 mt-1">
                        <span>📧 @Model.Customer.Email</span>
                        @if (!string.IsNullOrEmpty(Model.Customer.Phone))
                        {
                            <span>📞 @Model.Customer.Phone</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Customer.Address))
                        {
                            <span>📍 @Model.Customer.Address</span>
                        }
                    </div>
                </div>
            </div>

            <button type="button" onclick="AiAssistant.open(); AiAssistant.sendMessage('Summarize billing history for @Model.Customer.Name')"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-brand-700 text-xs font-bold transition-all border border-indigo-200 shadow-sm shrink-0">
                <span>✨ Ask AI about @Model.Customer.Name</span>
            </button>
        </div>

        @if (Model.Summary is not null)
        {
            <!-- Customer Billing Metrics -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-soft">
                    <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Invoices</div>
                    <div class="text-xl font-bold text-slate-900 mt-1">@Model.Summary.TotalInvoices</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-soft">
                    <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Paid Invoices</div>
                    <div class="text-xl font-bold text-emerald-600 mt-1">@Model.Summary.PaidInvoices</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-soft">
                    <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Outstanding</div>
                    <div class="text-xl font-bold text-amber-600 mt-1">@Model.Summary.OutstandingInvoices</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-soft">
                    <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Invoiced</div>
                    <div class="text-xl font-bold text-slate-900 mt-1">@CurrencyHelper.FormatNaira(Model.Summary.TotalInvoiced)</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-soft">
                    <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Paid</div>
                    <div class="text-xl font-bold text-brand-600 mt-1">@CurrencyHelper.FormatNaira(Model.Summary.TotalPaid)</div>
                </div>
            </div>
        }

        <!-- Invoices for Customer -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-soft overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Invoices for @Model.Customer.Name</h3>
                    <p class="text-xs text-slate-500">Historical billing ledger</p>
                </div>
                <span class="text-xs font-semibold text-slate-500">@Model.Invoices.Count records</span>
            </div>

            @if (Model.Invoices.Count == 0)
            {
                <div class="p-8 text-center text-slate-400">
                    <p class="text-xs">No invoices have been issued to this customer yet.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 text-[11px] font-semibold text-slate-400 uppercase tracking-wider bg-slate-50/50">
                                <th class="py-3 px-5">Invoice #</th>
                                <th class="py-3 px-4">Issue Date</th>
                                <th class="py-3 px-4">Due Date</th>
                                <th class="py-3 px-4 text-right">Amount</th>
                                <th class="py-3 px-4 text-center">Status</th>
                                <th class="py-3 px-5 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-xs">
                            @foreach (var inv in Model.Invoices)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-5 font-semibold text-brand-600">
                                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id" class="hover:underline">
                                            @inv.InvoiceNumber
                                        </a>
                                    </td>
                                    <td class="py-3.5 px-4 text-slate-600">@DateHelper.Format(inv.IssueDate)</td>
                                    <td class="py-3.5 px-4 text-slate-600">@DateHelper.Format(inv.DueDate)</td>
                                    <td class="py-3.5 px-4 text-right font-semibold text-slate-900">@CurrencyHelper.FormatNaira(inv.TotalAmount)</td>
                                    <td class="py-3.5 px-4 text-center">
                                        <partial name="_InvoiceStatusBadge" model="inv.Status" />
                                    </td>
                                    <td class="py-3.5 px-5 text-right">
                                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id"
                                           class="text-xs font-semibold text-slate-600 hover:text-brand-600">
                                            View &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    @if (Model.Customer is not null)
    {
        <script>
            // Set context for AI Assistant
            window.__AI_CONTEXT__ = {
                page: "CustomerDetails",
                customerId: "@Model.Customer.Id",
                customerName: "@Model.Customer.Name"
            };
        </script>
    }
}
