@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
    ViewData["Breadcrumb"] = "Directory";
}

<div class="space-y-6">
    <!-- Action Bar & Search -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-soft">
        <form method="get" class="flex-1 max-w-md flex items-center gap-2">
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <input type="text" name="search" value="@Model.SearchTerm"
                       placeholder="Search customers by name, email, or phone..."
                       class="w-full pl-9 pr-3 py-2 text-xs sm:text-sm rounded-xl border border-slate-300 focus:border-brand-500 focus:ring-brand-500 bg-slate-50 focus:bg-white transition-all" />
            </div>
            <button type="submit" class="px-4 py-2 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition-colors shrink-0">
                Search
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Index" class="px-3 py-2 text-xs font-medium text-slate-500 hover:text-slate-800 shrink-0">
                    Clear
                </a>
            }
        </form>

        <div class="flex items-center gap-2 shrink-0">
            <button type="button" onclick="AiAssistant.open(); AiAssistant.sendMessage('Who is our largest customer and who has the highest unpaid balance?')"
                    class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-indigo-50 hover:bg-indigo-100 text-brand-700 border border-brand-200 transition-colors">
                <span>✨ AI Insights</span>
            </button>

            <button type="button" onclick="CustomersManager.openCreateModal()"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white shadow-sm hover:shadow transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                <span>Add Customer</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 flex items-center justify-between">
            <div class="text-xs">@Model.ErrorMessage</div>
            <a asp-action="Index" class="text-xs font-semibold underline">Retry</a>
        </div>
    }

    <!-- Customers Table -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-soft overflow-hidden">
        @if (Model.Customers.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="text-4xl mb-3">👥</div>
                <h3 class="text-base font-bold text-slate-900">No customers found</h3>
                <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                    @(string.IsNullOrEmpty(Model.SearchTerm) ? "Get started by registering your first customer profile." : "No customer records matched your query.")
                </p>
                <button type="button" onclick="CustomersManager.openCreateModal()"
                        class="mt-4 px-4 py-2 text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white rounded-xl shadow-sm transition-colors">
                    Add First Customer
                </button>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 text-[11px] font-semibold text-slate-400 uppercase tracking-wider bg-slate-50/50">
                            <th class="py-3.5 px-6">Customer / Company</th>
                            <th class="py-3.5 px-4">Email</th>
                            <th class="py-3.5 px-4">Phone</th>
                            <th class="py-3.5 px-4">Address</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs">
                        @foreach (var customer in Model.Customers)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-100 to-indigo-100 text-brand-700 font-bold text-xs flex items-center justify-center shrink-0">
                                            @customer.Name.Substring(0, Math.Min(2, customer.Name.Length)).ToUpperInvariant()
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@customer.Id" class="font-bold text-slate-900 hover:text-brand-600 block">
                                                @customer.Name
                                            </a>
                                            <span class="text-[11px] text-slate-400 font-normal">Customer ID: @customer.Id.ToString()[..8]</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4 font-medium text-slate-700">@customer.Email</td>
                                <td class="py-4 px-4 text-slate-500">@(customer.Phone ?? "—")</td>
                                <td class="py-4 px-4 text-slate-500 max-w-xs truncate">@(customer.Address ?? "—")</td>
                                <td class="py-4 px-6 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <button type="button" onclick="CustomersManager.openEditModal('@customer.Id')"
                                                class="px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:text-brand-600 bg-slate-100 hover:bg-brand-50 rounded-lg transition-colors">
                                            Edit
                                        </button>
                                        <a asp-action="Details" asp-route-id="@customer.Id"
                                           class="px-2.5 py-1.5 text-xs font-semibold text-brand-600 hover:text-white bg-brand-50 hover:bg-brand-600 rounded-lg transition-colors">
                                            View &rarr;
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
