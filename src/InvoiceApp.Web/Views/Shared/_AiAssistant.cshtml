<!-- Floating AI Indicator Pill (Bottom-Right) -->
<button type="button" id="ai-indicator"
        class="fixed bottom-6 right-6 z-40 flex items-center gap-3 px-4 py-3 bg-white hover:bg-slate-50 text-slate-900 rounded-2xl border border-brand-200 shadow-floating hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 group focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">
    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-700 via-brand-600 to-indigo-500 text-white flex items-center justify-center text-lg shadow-md shadow-brand-500/30 group-hover:scale-105 transition-transform shrink-0">
        ✨
    </div>
    <div class="text-left pr-1">
        <div class="text-sm font-bold text-slate-900 group-hover:text-brand-600 transition-colors flex items-center gap-1.5">
            <span>Ask Invoice AI</span>
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        </div>
        <div class="text-xs text-slate-500">Chat about your invoices</div>
    </div>
</button>

<!-- AI Assistant Chat Panel (Compact & Expandable) -->
<div id="ai-chat-panel"
     class="fixed bottom-6 right-6 z-50 hidden bg-white rounded-2xl border border-slate-200/90 shadow-2xl flex flex-col overflow-hidden transition-all duration-300 w-[92vw] sm:w-[420px] h-[600px]">
    
    <!-- Chat Header -->
    <div class="px-4 py-3 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800 shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-500 to-indigo-400 text-white flex items-center justify-center text-sm shadow font-bold">
                ✨
            </div>
            <div>
                <h3 class="text-sm font-bold tracking-tight text-white flex items-center gap-2">
                    <span>Invoice AI Assistant</span>
                    <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-brand-500/20 text-brand-300 border border-brand-500/30">MAF</span>
                </h3>
                <div class="flex items-center gap-1.5 text-[11px] text-slate-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Multi-Agent Swarm • Live Coordinator</span>
                </div>
            </div>
        </div>

        <!-- Controls: Clear, Minimize, Expand/Collapse, Close -->
        <div class="flex items-center gap-1">
            <!-- Clear Button -->
            <button type="button" id="ai-clear-btn" title="Clear conversation"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </button>

            <!-- Expand Button -->
            <button type="button" id="ai-expand-btn" title="Expand to workspace"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none">
                <svg id="ai-expand-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
            </button>

            <!-- Minimize Button -->
            <button type="button" id="ai-minimize-btn" title="Minimize"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                </svg>
            </button>

            <!-- Close Button -->
            <button type="button" id="ai-close-btn" title="Close"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-slate-800 transition-colors focus:outline-none">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Chat Messages Scroll Container -->
    <div id="ai-messages" class="flex-1 p-4 overflow-y-auto space-y-4 bg-slate-50/50 custom-scrollbar">
        <!-- Welcome Message -->
        <div class="flex gap-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand-600 to-indigo-400 text-white flex items-center justify-center shrink-0 shadow-sm mt-0.5 text-xs font-bold">
                AI
            </div>
            <div class="max-w-[88%] bg-white border border-slate-200/80 rounded-2xl rounded-tl-sm p-4 shadow-sm text-slate-800">
                <div class="text-xs font-semibold text-brand-600 mb-1">Invoice AI Assistant</div>
                <p class="text-sm leading-relaxed mb-3">
                    Hi! I'm your <strong>Invoice AI Assistant</strong>. Ask me anything about your invoices, debtors, billing activity, or cash collections.
                </p>
                <div class="text-xs text-slate-500 font-medium mb-2">Suggested prompts to get started:</div>
                <div id="ai-suggestions" class="flex flex-wrap gap-1.5">
                    <!-- Populated dynamically via JS -->
                </div>
            </div>
        </div>

        <!-- Typing Indicator (Hidden by default) -->
        <div id="ai-typing" class="hidden flex gap-3 items-center">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand-600 to-indigo-400 text-white flex items-center justify-center shrink-0 shadow-sm text-xs font-bold">
                AI
            </div>
            <div class="bg-white border border-slate-200/80 rounded-2xl rounded-tl-sm px-4 py-2.5 shadow-sm inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-brand-500 animate-bounce" style="animation-delay: 0ms"></span>
                <span class="w-2 h-2 rounded-full bg-brand-500 animate-bounce" style="animation-delay: 150ms"></span>
                <span class="w-2 h-2 rounded-full bg-brand-500 animate-bounce" style="animation-delay: 300ms"></span>
            </div>
        </div>
    </div>

    <!-- Chat Input Area -->
    <div class="p-3 bg-white border-t border-slate-200 shrink-0">
        <div class="flex items-end gap-2 bg-slate-50 border border-slate-200 rounded-xl p-2 focus-within:border-brand-500 focus-within:ring-1 focus-within:ring-brand-500 transition-all">
            <textarea id="ai-input" rows="1"
                      placeholder="Ask about customers, invoices, payments or outstanding balances..."
                      class="flex-1 bg-transparent border-0 resize-none text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0 max-h-28 custom-scrollbar py-1 px-1"></textarea>
            
            <button type="button" id="ai-send-btn" disabled
                    class="p-2 rounded-lg bg-brand-600 hover:bg-brand-700 disabled:opacity-40 disabled:hover:bg-brand-600 text-white transition-all shadow-sm shrink-0"
                    title="Send message">
                <svg class="w-4 h-4 transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
            </button>
        </div>
        <div class="flex items-center justify-between text-[10px] text-slate-400 mt-1.5 px-1">
            <span>Press <kbd class="px-1 bg-slate-100 border border-slate-200 rounded text-slate-600">Enter</kbd> to send, <kbd class="px-1 bg-slate-100 border border-slate-200 rounded text-slate-600">Shift+Enter</kbd> for newline</span>
            <span class="text-brand-600 font-semibold">Microsoft Agent Framework</span>
        </div>
    </div>
</div>
