<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InvoiceAI Studio</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind Compiled Styles -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="h-full antialiased font-sans bg-slate-50 text-slate-900 selection:bg-brand-500 selection:text-white">
    @Html.AntiForgeryToken()

    <!-- App Sidebar -->
    <partial name="_SharedSidebar" />

    <!-- Main Content Area -->
    <div class="lg:pl-64 flex flex-col min-h-screen">
        <!-- Top Navigation Bar -->
        <partial name="_TopNavigation" />

        <!-- Page Body -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="py-4 px-6 border-t border-slate-200/80 bg-white/60 text-xs text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-2">
            <div>
                &copy; @DateTime.UtcNow.Year <span class="font-semibold text-slate-600">InvoiceAI Studio</span>. Developer Training Project for Microsoft Agent Framework.
            </div>
            <div class="flex items-center gap-4 text-[11px]">
                <span class="inline-flex items-center gap-1.5 text-slate-500">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> API Status: Connected
                </span>
                <span>.NET 10 MVC</span>
            </div>
        </footer>
    </div>

    <!-- Modals -->
    <partial name="_CustomerModal" />
    <partial name="_CreateInvoiceModal" />
    <partial name="_StatusChangeModal" />
    <partial name="_DeleteInvoiceModal" />

    <!-- AI Assistant Floating UI & Chat Panel -->
    <partial name="_AiAssistant" />

    <!-- Reusable Toast Notifications Container -->
    <partial name="_ToastContainer" />

    <!-- Core Scripts -->
    <script src="~/js/toasts.js" asp-append-version="true"></script>
    <script src="~/js/modals.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/ai-assistant.js" asp-append-version="true"></script>
    <script src="~/js/customers.js" asp-append-version="true"></script>
    <script src="~/js/invoices.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
