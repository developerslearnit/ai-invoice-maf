<!-- Invoice Create Modal -->
<div id="invoice-create-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="invoice-create-title" role="dialog" aria-modal="true">
    <div class="min-h-screen px-4 text-center flex items-center justify-center">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" data-modal-backdrop></div>

        <!-- Modal Dialog -->
        <div class="inline-block w-full max-w-3xl p-6 sm:p-8 my-8 text-left align-middle transition-all transform bg-white shadow-2xl rounded-2xl relative border border-slate-200">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-lg">
                        📄
                    </div>
                    <div>
                        <h3 id="invoice-create-title" class="text-base sm:text-lg font-bold text-slate-900">Create New Invoice</h3>
                        <p class="text-xs text-slate-500">Draft an invoice with dynamic itemized lines and client billing dates.</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-50 transition-colors" data-modal-close="invoice-create-modal">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Form -->
            <form id="invoice-create-form" class="mt-6 space-y-6">
                <!-- Row 1: Customer & Dates -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label for="inv-customer-id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Customer *</label>
                        <select id="inv-customer-id" required
                                class="w-full text-sm rounded-xl border-slate-300 focus:border-brand-500 focus:ring-brand-500 py-2.5 px-3 border bg-white">
                            <option value="">Select a customer...</option>
                        </select>
                    </div>

                    <div>
                        <label for="inv-issue-date" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Issue Date *</label>
                        <input type="date" id="inv-issue-date" required
                               class="w-full text-sm rounded-xl border-slate-300 focus:border-brand-500 focus:ring-brand-500 py-2.5 px-3 border bg-white" />
                    </div>

                    <div>
                        <label for="inv-due-date" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Due Date *</label>
                        <input type="date" id="inv-due-date" required
                               class="w-full text-sm rounded-xl border-slate-300 focus:border-brand-500 focus:ring-brand-500 py-2.5 px-3 border bg-white" />
                    </div>
                </div>

                <!-- Row 2: Dynamic Line Items -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-xs font-semibold text-slate-700 uppercase tracking-wider">Line Items *</label>
                        <button type="button" id="add-item-row-btn"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-lg transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                            <span>Add Item</span>
                        </button>
                    </div>

                    <!-- Column Headers (Hidden on Mobile) -->
                    <div class="hidden sm:grid grid-cols-12 gap-3 px-3 py-1.5 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                        <div class="col-span-5">Description</div>
                        <div class="col-span-2 text-right">Qty</div>
                        <div class="col-span-3 text-right">Unit Price (₦)</div>
                        <div class="col-span-2 text-right">Line Total</div>
                    </div>

                    <!-- Rows Container -->
                    <div id="invoice-items-container" class="space-y-2.5 max-h-60 overflow-y-auto custom-scrollbar pr-1">
                        <!-- Populated by JavaScript -->
                    </div>

                    <!-- Live Calculated Total Banner -->
                    <div class="mt-4 p-4 rounded-xl bg-slate-900 text-white flex items-center justify-between">
                        <div class="text-xs text-slate-400 font-medium">Estimated Invoice Total</div>
                        <div class="text-lg sm:text-xl font-bold tracking-tight text-white" id="inv-calculated-total">₦0.00</div>
                    </div>
                </div>

                <!-- Row 3: Notes -->
                <div>
                    <label for="inv-notes" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Notes / Terms</label>
                    <textarea id="inv-notes" rows="2" maxlength="1000"
                              placeholder="Payment terms: Due within 14 days. Thank you for your business."
                              class="w-full text-sm rounded-xl border-slate-300 focus:border-brand-500 focus:ring-brand-500 py-2 px-3 border bg-white resize-none"></textarea>
                </div>

                <!-- Modal Actions -->
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                    <button type="button" data-modal-close="invoice-create-modal"
                            class="px-4 py-2.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                        Cancel
                    </button>
                    <button type="submit" id="inv-submit-btn"
                            class="inline-flex items-center gap-2 px-6 py-2.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl shadow-sm transition-all disabled:opacity-60">
                        <svg id="inv-submit-spinner" class="w-4 h-4 animate-spin hidden text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Create Invoice</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Ensure customer dropdown options are populated when opening create modal
    document.addEventListener('DOMContentLoaded', async () => {
        try {
            const res = await fetch('/customers/list');
            if (res.ok) {
                const customers = await res.json();
                const select = document.getElementById('inv-customer-id');
                if (select && Array.isArray(customers)) {
                    customers.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.id;
                        opt.textContent = `${c.name} (${c.email})`;
                        select.appendChild(opt);
                    });
                }
            }
        } catch (_) {}
    });
</script>
